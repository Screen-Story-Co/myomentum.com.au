---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}
const { title, description, ogImage, ogType = 'website' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/bookings', label: 'Bookings' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

// Social / SEO.
// og:image and og:url must be absolute URLs a scraper can fetch. Astro.site is
// the launch home (yiapanis.co, still served by Weebly), so absolute ASSET paths
// resolve against the preview origin until cutover — then delete ASSET_ORIGIN
// and use Astro.site.origin.
const ASSET_ORIGIN = 'https://myomentum.preview.screenstory.co';

// Default description for pages that pass none. Kept long-form on purpose: it
// describes the site in search results and link cards, where the shorter
// on-page intro ("Drop me a message...") would read as a call to action rather
// than a description.
const DEFAULT_DESCRIPTION =
  'Myomentum — clinical myotherapy in St Kilda. Integrated care for muscle, joint and nerve pain by Phil Papadopoulos.';
const desc = description ?? DEFAULT_DESCRIPTION;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage ?? '/images/hero-bg.jpg', ASSET_ORIGIN).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Myomentum" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Public+Sans:ital,wght@0,300;0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&family=EB+Garamond:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      /* Paper programme: off-white stock, pure-white plates, ink, one oxide accent */
      --bg: #f6f8fa;
      --plate: #ffffff;
      --fg: #141414;
      --muted: #6a6a66;
      --faint: #9c9c96;
      --accent: #2ba9e0;
      --accent-2: #1b8cc4;
      --accent-ink: #0e4a6b;
      --border: #e2e8ef;
      --rule: #d6e4f0;
      --font-display: 'Newsreader', Georgia, serif;
      --font-body: 'Public Sans', system-ui, sans-serif;
      --font-mono: 'IBM Plex Mono', ui-monospace, monospace;
      --font-serif: 'Newsreader', Georgia, serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { animation: none !important; transition: none !important; } }
    /* fluid type */
    :root { --gap: clamp(1rem, 3vw, 2rem); }
    .reveal { opacity: 0; transform: translateY(12px); transition: opacity .6s ease, transform .6s ease; }
    .reveal.in { opacity: 1; transform: none; }
    .site-header.scrolled { box-shadow: 0 6px 24px rgba(0,0,0,.06); background: rgba(251,251,249,.92); }
    .site-nav a { transition: opacity .2s, color .2s, transform .2s; }
    .site-nav a:hover { transform: translateY(-1px); }
    .hero-cta,.btn { transition: transform .2s, background .2s, color .2s, box-shadow .2s; }
    .hero-cta:hover,.btn:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(0,0,0,.08); }
    .trusted img { transition: transform .2s, opacity .2s; }
    .trusted img:hover { transform: translateY(-2px); opacity: 1; }
    .map { overflow: hidden; border-radius: 12px; }
    .sheet { border-radius: 12px; }
    .hero { clip-path: inset(0); }
    .hero-bg img { will-change: transform; transform: scale(1.06); transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
    .hero.in .hero-bg img { transform: scale(1); }
    .hero-logo { transition: transform .9s cubic-bezier(.16,1,.3,1), opacity .9s ease; }
    .hero.in .hero-logo { animation: floatIn .9s ease both; }
    @keyframes floatIn { from { opacity:0; transform: translateY(14px); } to { opacity:1; transform: none; } }
    .hero-line, .hero-cta, .hero-address { opacity:0; transform: translateY(10px); transition: opacity .7s ease, transform .7s cubic-bezier(.16,1,.3,1); }
    .hero.in .hero-line { opacity:1; transform:none; transition-delay:.12s; }
    .hero.in .hero-cta { opacity:1; transform:none; transition-delay:.22s; }
    .hero.in .hero-address { opacity:1; transform:none; transition-delay:.30s; }
    .site-nav a[aria-current="page"]::after { background: var(--accent); height:2px; }
    .brand { font-family: "Montserrat", system-ui, sans-serif; font-weight: 200; letter-spacing: .42em; font-size: .95rem; text-transform: uppercase; display:flex; align-items:center; gap:0; }
    .brand .myo { color: #2ba9e0; font-weight: 500; }
    .brand .mentum { color: #c9d0d6; font-weight: 200; }
    .sr-only { position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden; }
    .hero-logo-text { font-family: "Montserrat", "Raleway", system-ui, sans-serif; font-size: clamp(2.4rem, 6vw, 4.2rem); letter-spacing: .42em; font-weight: 200; text-transform: uppercase; line-height:1; }
    .hero-logo-text .myo { color: #2ba9e0; font-weight: 600; }
    .hero-logo-text .mentum { color: rgba(213,213,213,.95); font-weight: 300; }

    .btn { background: var(--accent); border-color: var(--accent); color:#fff; }
    .btn:hover { background: var(--accent-ink); border-color: var(--accent-ink); }


    body {
      font-family: var(--font-body);
      background: var(--bg);
      color: var(--fg);
      line-height: 1.7;
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--fg); text-decoration: none; transition: color .2s; }
    a:hover { color: var(--accent); }
    img { max-width: 100%; height: auto; display: block; }
    ::selection { background: var(--accent); color: var(--bg); }

    .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

    /* Navigation */
    .site-header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(251,251,249,0.88);
      backdrop-filter: blur(14px) saturate(1.4);
      border-bottom: 1px solid var(--border);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.2rem 1rem;
      position: relative;
    }
    .hamburger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      flex-direction: column;
      gap: 5px;
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
    }
    .hamburger span {
      display: block;
      width: 24px;
      height: 1px;
      background: var(--fg);
      transition: all 0.3s;
    }
    .site-nav {
      display: flex; justify-content: center; gap: 2.5rem;
    }
    .site-nav a {
      font-family: var(--font-mono);
      text-transform: uppercase;
      font-size: 0.66rem;
      letter-spacing: 0.16em;
      font-weight: 400;
      opacity: 0.55;
      position: relative;
      padding-bottom: 2px;
    }
    .site-nav a:hover, .site-nav a[aria-current="page"] { opacity: 1; color: var(--accent); }
    .site-nav a[aria-current="page"]::after {
      content: ''; position: absolute; bottom: -4px; left: 0; right: 0;
      height: 1px; background: var(--accent);
    }

    /* Typography */
    .page-title {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: 2rem;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .page-subtitle {
      font-family: var(--font-serif);
      font-style: italic;
      color: var(--muted);
      font-size: 1rem;
      font-weight: 400;
    }
    .section-title {
      font-family: var(--font-display);
      font-weight: 300;
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--accent);
      margin: 3rem 0 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }

    /* Buttons */
    .btn {
      display: inline-block;
      font-family: var(--font-mono);
      border: 1px solid var(--fg);
      padding: 0.72rem 1.5rem;
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-weight: 400;
      transition: background .25s, color .25s, border-color .25s;
      background: transparent;
      color: var(--fg);
      cursor: pointer;
    }
    .btn:hover { background: var(--fg); color: var(--bg); }
    .btn-accent {
      border-color: var(--accent);
      color: var(--accent);
    }
    .btn-accent:hover { background: var(--accent); color: var(--bg); }

    /* Cards */
    .card {
      background: var(--plate);
      border: 1px solid var(--border);
      padding: 2rem;
      transition: border-color .2s, transform .2s;
    }
    .card:hover { border-color: var(--accent); transform: translateY(-2px); }

    /* Form fields */
    .field-label {
      display: block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
      color: var(--muted);
    }
    .field-input {
      width: 100%;
      padding: 0.8rem;
      background: var(--plate);
      border: 1px solid var(--border);
      color: var(--fg);
      font-family: var(--font-body);
      font-size: 0.9rem;
      outline: none;
      transition: border-color .2s;
    }
    .field-input:focus { border-color: var(--accent); }
    .field-input::placeholder { color: var(--muted); opacity: 0.5; }

    /* Grid */
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .grid-auto { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }

    /* Profile grid */
    .profile-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
      align-items: start;
      padding: 3rem 0;
    }

    .profile-photo {
      width: 220px;
      height: 220px;
      object-fit: cover;
      object-position: center top;
      border-radius: 50%;
      margin: 1rem auto;
      border: 2px solid var(--border);
      transition: border-color .2s;
    }
    .profile-photo:hover { border-color: var(--accent); }

    /* Gallery */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
      margin: 2rem 0;
    }
    .gallery img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 2px;
      cursor: pointer;
      transition: transform 0.2s;
    }
    .gallery img:hover { transform: scale(1.02); }
    .prose img {
      max-width: 100%;
      height: auto;
      margin: 1.5rem 0;
      border-radius: 2px;
    }
    .prose figure {
      margin: 1.5rem 0;
    }
    .prose figcaption {
      font-size: 0.8rem;
      color: var(--muted);
      font-style: italic;
      margin-top: 0.5rem;
    }

    /* Footer */
    .site-footer {
      text-align: center; padding: 3rem 1rem;
      font-size: 0.7rem; color: var(--muted);
      border-top: 1px solid var(--border);
      margin-top: 4rem;
    }

    /* Breadcrumb */
    .breadcrumb { margin-bottom: 2rem; }
    .breadcrumb a { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--muted); }

    /* Section utilities */
    .section-rule { border: none; border-top: 1px solid var(--border); margin: 3rem 0; }
    .section-lead { margin-bottom: 1.5rem; color: var(--muted); font-size: 0.9rem; }
    .empty-card { text-align: center; padding: 4rem; }

    /* Film grid & cards */
    .film-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-top: 2rem; }
    .film-card { display: block; background: var(--plate); border: 1px solid var(--border); overflow: hidden; transition: border-color .2s, transform .2s; }
    .film-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .film-poster-wrap { width: 100%; aspect-ratio: 2/3; overflow: hidden; }
    .film-poster-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .film-poster-missing { background: var(--plate); display: flex; align-items: center; justify-content: center; }
    .film-poster-missing p { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; }
    .film-card-body { padding: 1.5rem; }
    .film-card-title { font-family: var(--font-display); font-weight: 400; font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--fg); }
    .film-card-meta { font-size: 0.75rem; color: var(--accent); letter-spacing: 0.05em; margin-bottom: 1rem; }
    .film-card-synopsis { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin-bottom: 1rem; }
    .film-card-cta { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); border-bottom: 1px solid transparent; transition: border-color .2s; }
    .film-card:hover .film-card-cta { border-color: var(--accent); }

    /* Film detail */
    .film-detail { margin-top: 2rem; }
    .film-detail-header { display: grid; grid-template-columns: 280px 1fr; gap: 3rem; align-items: start; }
    .film-detail-poster { width: 100%; aspect-ratio: 2/3; object-fit: cover; border: 1px solid var(--border); }
    .film-detail-title { font-family: var(--font-display); font-weight: 300; font-size: 2rem; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .film-detail-meta { font-size: 0.85rem; color: var(--accent); letter-spacing: 0.05em; margin-bottom: 1.5rem; }
    .film-detail-synopsis { font-size: 1rem; color: var(--muted); line-height: 1.7; }
    .film-player { margin-top: 3rem; }

    /* Dev grid & cards */
    .dev-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-top: 2rem; }
    .dev-card { display: block; background: var(--plate); border: 1px solid var(--border); overflow: hidden; transition: border-color .2s, transform .2s; }
    .dev-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .dev-poster-wrap { aspect-ratio: 3/2; overflow: hidden; }
    .dev-poster-wrap img { width: 100%; height: 100%; object-fit: cover; }
    .dev-card-body { padding: 1.5rem; }
    .dev-card-header { display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem; }
    .dev-card-title { font-family: var(--font-display); font-weight: 400; font-size: 1.2rem; margin: 0; color: var(--fg); }
    .dev-card-status { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); border: 1px solid var(--border); padding: 0.3rem 0.6rem; white-space: nowrap; margin-left: 1rem; }
    .dev-card-logline { font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem; }
    .dev-card-meta { font-size: 0.75rem; color: var(--muted); margin-bottom: 1rem; }
    .dev-card-cta { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--accent); border-bottom: 1px solid transparent; transition: border-color .2s; }
    .dev-card:hover .dev-card-cta { border-color: var(--accent); }

    /* Project detail */
    .project-detail { margin-top: 2rem; }
    .project-detail-header { display: grid; grid-template-columns: 320px 1fr; gap: 3rem; align-items: start; }
    .project-detail-poster { width: 100%; aspect-ratio: 3/2; object-fit: cover; border: 1px solid var(--border); }
    .project-detail-status { display: inline-block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); border: 1px solid var(--border); padding: 0.3rem 0.6rem; margin-bottom: 1rem; }
    .project-detail-title { font-family: var(--font-display); font-weight: 300; font-size: 2rem; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .project-detail-meta { font-size: 0.85rem; color: var(--accent); letter-spacing: 0.05em; margin-bottom: 1.5rem; }
    .project-detail-logline { font-size: 1rem; color: var(--muted); line-height: 1.7; }
    .project-detail-body { margin-top: 3rem; }
    .project-detail-body p { margin-bottom: 1.2rem; line-height: 1.8; font-size: 1.05rem; color: var(--fg); }

    /* Blog list */
    .blog-list { margin-top: 2rem; }
    .blog-entry { margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
    .blog-entry-title a { font-family: var(--font-display); font-weight: 400; font-size: 1.3rem; }
    .blog-entry-date { font-size: 0.72rem; color: var(--muted); letter-spacing: 0.05em; text-transform: uppercase; margin: 0.5rem 0 1rem; }
    .blog-entry-excerpt { color: var(--muted); font-size: 0.9rem; }

    /* Contact inline form */
    .contact-form-inline { max-width: 500px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    .contact-form-inline .btn { margin-top: 1.5rem; }

    @media (max-width: 768px) {
      .hamburger { display: flex; }
      .header-inner { justify-content: flex-start; padding: 1rem; }
      .site-nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(251,251,249,0.97);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.5rem;
        text-align: center;
      }
      .site-nav.open { display: flex; }
      .site-nav a { font-size: 0.9rem; }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .grid-auto { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .page-title { font-size: 1.6rem; }
      .profile-grid { grid-template-columns: 1fr; gap: 2rem; padding: 2rem 0; }
      .film-detail-header { grid-template-columns: 1fr; }
      .project-detail-header { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .sheet { grid-template-columns: 1fr; gap: 1rem; padding: 2.5rem 0 0; }
      .sheet + .sheet { margin-top: 2.5rem; }
      .sheet-rail { position: static; padding-top: 0; margin-bottom: .4rem; }
      .brand { font-size: .82rem; letter-spacing: .22em; }
      .site-footer { padding: 2rem 1rem; }
      .container { padding: 0 1rem; }
      .hero { min-height: 72vh; min-height: 72dvh; }
      .hero-inner { padding: 3rem 1.25rem 2.5rem; }
      .hero-logo-text { font-size: clamp(1.9rem, 8vw, 2.6rem); letter-spacing: .18em; line-height:1.15; }
      .hero-line { font-size: clamp(.95rem, 4.2vw, 1.08rem); letter-spacing: .5px; }
      .hero-logo-text { word-break: break-word; }
    }

    /* ── Publication vocabulary ───────────────────────────────
       Shared by every page so index/films/journal/contact read as one
       printed programme. Defined once here; pages consume the classes. */
    .sheet {
      display: grid; grid-template-columns: 8.5rem 1fr;
      gap: 0 3.5rem; padding: 4.5rem 0 0; scroll-margin-top: 5rem;
    }
    .sheet + .sheet { border-top: 1px solid var(--border); margin-top: 4.5rem; }
    .sheet-rail {
      display: flex; flex-direction: column;
      padding-top: .5rem; position: sticky; top: 6.5rem; align-self: start;
    }
    .rail-label {
      font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase;
      letter-spacing: .17em; color: var(--muted); line-height: 1.5;
    }
    .sheet-body { min-width: 0; max-width: 74ch; }
    .sheet-note {
      font-family: var(--font-mono); font-size: .64rem; text-transform: uppercase;
      letter-spacing: .16em; color: var(--faint);
      padding-bottom: 1.5rem; margin-bottom: 2.25rem; border-bottom: 1px solid var(--border);
    }
    .sheet-outro { margin-top: 3rem; }
    .link { color: var(--accent); border-bottom: 1px solid transparent; transition: border-color .22s; }
    .link:hover { border-bottom-color: var(--accent); }

    /* Plates — prints laid on the paper */
    .plates {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
      gap: 3rem 2rem;
    }
    .plate-card { display: block; }
    .plate {
      position: relative; aspect-ratio: 0.708;
      background: var(--plate); padding: 0.85rem; border: 1px solid var(--border);
      box-shadow:
        0 1.5px 2px rgba(20,20,20,.055),
        0 8px 18px -8px rgba(20,20,20,.16),
        0 22px 40px -22px rgba(20,20,20,.22);
      transition: box-shadow .5s cubic-bezier(.2,.8,.2,1), transform .5s cubic-bezier(.2,.8,.2,1);
    }
    .plate img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .plate-card:hover .plate {
      transform: translateY(-6px);
      box-shadow:
        0 2px 3px rgba(20,20,20,.07),
        0 16px 30px -10px rgba(20,20,20,.22),
        0 40px 64px -30px rgba(20,20,20,.3);
    }
    .plate-blank {
      height: 100%; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: .7rem;
      padding: 1.25rem; text-align: center;
      background:
        repeating-linear-gradient(-45deg, rgba(154,51,36,.045) 0 1px, transparent 1px 10px),
        #f7f7f4;
    }
    .plate-blank-title { font-family: var(--font-display); font-size: 1.12rem; color: var(--fg); }
    .plate-blank-type {
      font-family: var(--font-mono); font-size: .58rem;
      text-transform: uppercase; letter-spacing: .17em; color: var(--accent);
    }
    .plate-info { padding-top: 1.1rem; }
    .plate-title {
      font-family: var(--font-display); font-weight: 400;
      font-size: 1.12rem; letter-spacing: -0.006em; margin-bottom: .3rem;
    }
    .plate-card:hover .plate-title { color: var(--accent); }
    .plate-meta {
      font-family: var(--font-mono); font-size: .6rem;
      text-transform: uppercase; letter-spacing: .13em; color: var(--muted);
    }
    .plate-synopsis {
      font-family: var(--font-serif); font-size: .82rem; line-height: 1.5;
      color: var(--muted); margin-top: .6rem;
    }

    /* In-development rows */
    .dev-list { display: flex; flex-direction: column; gap: 2.75rem; }
    .dev-row { display: grid; grid-template-columns: 12rem 1fr; gap: 2rem; align-items: start; }
    .dev-thumb {
      aspect-ratio: 3 / 2; overflow: hidden; background: var(--plate); padding: .5rem;
      border: 1px solid var(--border);
      box-shadow: 0 1.5px 2px rgba(20,20,20,.055), 0 10px 22px -12px rgba(20,20,20,.2);
      transition: box-shadow .5s cubic-bezier(.2,.8,.2,1), transform .5s cubic-bezier(.2,.8,.2,1);
    }
    .dev-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .dev-row:hover .dev-thumb {
      transform: translateY(-4px);
      box-shadow: 0 2px 3px rgba(20,20,20,.07), 0 18px 34px -14px rgba(20,20,20,.26);
    }
    .dev-text { padding-top: .15rem; }
    .dev-title {
      font-family: var(--font-display); font-weight: 400;
      font-size: 1.34rem; letter-spacing: -0.01em; margin-bottom: .3rem;
    }
    .dev-row:hover .dev-title { color: var(--accent); }
    .dev-logline { font-size: .96rem; color: var(--muted); line-height: 1.72; margin-top: .85rem; }

    /* Software index */
    .sw-index { list-style: none; }
    .sw-row {
      display: grid; grid-template-columns: 13.5rem 1fr;
      gap: .35rem 2.25rem; padding: 1.45rem 0;
      border-bottom: 1px solid var(--border); align-items: baseline;
    }
    .sw-row:last-of-type { border-bottom: none; }
    .sw-name {
      font-family: var(--font-mono); font-size: .8rem;
      letter-spacing: .01em; color: var(--fg); transition: color .22s;
    }
    .sw-name:hover { color: var(--accent); }
    .sw-name-static { color: var(--faint); }
    .sw-note { font-size: .93rem; color: var(--muted); line-height: 1.72; }
    .sw-meta {
      grid-column: 2; font-family: var(--font-mono); font-size: .58rem;
      text-transform: uppercase; letter-spacing: .15em; color: var(--faint);
    }
    .sw-spine {
      margin-top: 2.25rem; padding: 1.7rem 1.9rem;
      background: var(--plate); border: 1px solid var(--border);
      border-left: 2px solid var(--accent);
      box-shadow: 0 1.5px 2px rgba(20,20,20,.045), 0 12px 26px -16px rgba(20,20,20,.18);
      font-size: .95rem; color: var(--muted); line-height: 1.76;
    }
    .sw-spine-name {
      font-family: var(--font-display); font-size: 1.16rem;
      color: var(--fg); margin-right: .45rem;
    }

    /* Journal grid */
    .journal-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2.75rem;
    }
    .journal-date {
      font-family: var(--font-mono); font-size: .6rem; text-transform: uppercase;
      letter-spacing: .15em; color: var(--faint); margin-bottom: .8rem;
    }
    .journal-title a {
      font-family: var(--font-display); font-size: 1.28rem; line-height: 1.32;
      letter-spacing: -0.008em; display: block; margin-bottom: .6rem;
      border-bottom: 1px solid transparent; transition: color .22s, border-color .22s;
    }
    .journal-title a:hover { color: var(--accent); border-bottom-color: var(--accent); }
    .journal-excerpt { font-size: .91rem; color: var(--muted); line-height: 1.72; }

    /* Contact */
    .contact-title {
      font-family: var(--font-display); font-weight: 400;
      font-size: clamp(1.7rem, 3.4vw, 2.3rem); letter-spacing: -0.015em; margin-bottom: 1rem;
    }
    .contact-body { max-width: 54ch; color: var(--muted); font-size: 1rem; line-height: 1.75; }
    .contact-links {
      display: flex; gap: 2rem; margin-top: 1.85rem;
      font-family: var(--font-mono); font-size: .62rem;
      text-transform: uppercase; letter-spacing: .15em;
    }
    .contact-plain { color: var(--muted); }
    .contact-plain b { color: var(--fg); font-weight: 500; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <button type="button" class="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
<nav class="site-nav" id="site-nav" aria-label="Main">
        {nav.map(item => <a href={item.href} aria-current={Astro.url.pathname === item.href || Astro.url.pathname === item.href + '/' ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </div>
  </header>

  <main class="container">
    <slot />
  </main>

  <footer class="site-footer">
    &copy; {new Date().getFullYear()} Myomentum &nbsp;&middot;&nbsp; <a href="https://www.screenstory.co" style="text-decoration:underline">Website by Screen Story Co.</a>
  </footer>

  <script is:inline>
    (function() {
      var hamburger = document.querySelector('.hamburger');
      var nav = document.getElementById('site-nav');
      if (!hamburger || !nav) return;
      hamburger.addEventListener('click', function() {
        var expanded = hamburger.getAttribute('aria-expanded') === 'true';
        hamburger.setAttribute('aria-expanded', String(!expanded));
        nav.classList.toggle('open');
      });
    })();
    // header elevate on scroll
    const hdr = document.querySelector('.site-header');
    const onScroll = () => hdr && hdr.classList.toggle('scrolled', window.scrollY > 8);
    addEventListener('scroll', onScroll, {passive:true}); onScroll();
    // reveal-on-scroll
    const els = document.querySelectorAll('.sheet, .quote, .hero-inner');
    els.forEach(e => e.classList.add('reveal'));
    const io = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }}), {threshold:.12});
    els.forEach(e => io.observe(e));
    // hero enter
    requestAnimationFrame(() => document.querySelector('.hero')?.classList.add('in'));
    // subtle parallax on scroll
    let ticking=false;
    addEventListener('scroll', () => {
      if(ticking) return; ticking=true;
      requestAnimationFrame(() => {
        const y = window.scrollY * 0.12;
        document.querySelectorAll('.hero-bg img').forEach(img => img.style.transform = `translateY(${y}px) scale(${1 - Math.min(window.scrollY*0.00008,0.04)})`);
        ticking=false;
      });
    }, {passive:true});

  </script>
</body>
</html>
