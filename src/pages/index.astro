---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).slice(0,2);
---
<Base title="Myotherapy in St Kilda, Prahran, Balaclava & surrounds | Myomentum" description="Providing an integrated approach to muscle, joint and nerve related pain.">
  <header class="hero">
    <div class="hero-bg"><img src="/images/hero-weebly.jpg" alt="" aria-hidden="true" /></div>
    <div class="hero-inner">
      <img class="hero-logo" src="/images/logo.png" alt="MYOMENTUM" width="520" height="86" style="max-width:min(92%,520px);height:auto;margin:0 auto 1.6rem;display:block;filter: drop-shadow(0 2px 12px rgba(0,0,0,.25))" />
      <h1 class="hero-line">An integrated approach in the assessment and<br class="hide-mobile" /> management of muscle, joint and nerve related pain.</h1>
      <a class="hero-cta" href="/bookings">Book an appointment</a>
      <p class="hero-address">6–8 Farmer Street<br/>St Kilda</p>
    </div>
  </header>

  <section class="quote">
    <blockquote>“I've been seeing Phil for a while now and he is absolutely the best! He will not only treat the issue but will go above and beyond to see what is actually causing the issue. His knowledge is quite vast and will explain his findings to you so that you can comprehend. Have recommended Phil to a few friends as well and they are very grateful for it. Phil is the man! <span>— Ed</span>”</blockquote>
  </section>

  <section class="sheet">
    <div class="sheet-rail"><span class="rail-label">Our Location</span></div>
    <div class="sheet-body">
      <div class="map">
        <iframe src="https://www.google.com/maps?q=6-8+Farmer+Street+St+Kilda+VIC+3182&z=15&output=embed" width="100%" height="260" style="border:0" loading="lazy" title="Myomentum — St Kilda"></iframe>
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="sheet-rail"><span class="rail-label">Appointment Hours</span></div>
    <div class="sheet-body">
      <ul class="hours">
        <li><span>Monday</span><span>Closed</span></li>
        <li><span>Tue & Thu</span><span>8am – 5pm</span></li>
        <li><span>Wednesday</span><span>9am – 6pm</span></li>
        <li><span>Fri & Sat</span><span>8am – 1pm</span></li>
      </ul>
      <a class="btn" href="/bookings">Book an appointment</a>
    </div>
  </section>

  <section class="sheet">
    <div class="sheet-rail"><span class="rail-label">Trusted Partners</span></div>
    <div class="sheet-body trusted">
      <img src="/images/hicaps.webp" alt="HICAPS" height="56" />
      <img src="/images/ma-logo.png" alt="Myotherapy Association Australia" height="56" />
      <img src="/images/the-hunt.png" alt="The Hunt Strength & Conditioning" height="56" />
    </div>
  </section>
</Base>
<style>
.hero{position:relative;width:100vw;margin-left:calc(50% - 50vw);min-height:809px;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;background:#0b0b0b;margin-top:-1.2rem}
.hero-bg{position:absolute;inset:0} .hero-bg img{width:100%;height:100%;object-fit:cover;object-position:center 51%}
.hero-bg::after{content:'';position:absolute;inset:0;background:rgba(8,8,8,.35)}
.hero-inner{position:relative;max-width:900px;padding:4rem 2rem 3rem;color:#d5d5d5}
.hero-logo{max-width:520px;width:92%;height:auto;margin:0 auto 1.6rem;display:block}
.hero-line{font-family:"Trebuchet MS",sans-serif;color:#d5d5d5;font-weight:700;letter-spacing:1px;font-size:clamp(1.05rem,2.4vw,1.25rem);line-height:1.45}
.hero-cta{display:inline-block;margin-top:1.6rem;padding:.75rem 1.6rem;border:1px solid rgba(213,213,213,.9);color:#d5d5d5;font-family:"Montserrat",sans-serif;font-size:.78rem;letter-spacing:4px;text-transform:uppercase}
.hero-cta:hover{background:rgba(213,213,213,.12)}
.hero-address{margin-top:1.2rem;font-family:"Montserrat",sans-serif;font-size:.82rem;letter-spacing:3px;text-transform:uppercase;line-height:1.6;color:#d5d5d5}
.quote{max-width:840px;margin:3rem auto;padding:0 2rem;text-align:center}
.quote blockquote{font-family:"Libre Franklin",sans-serif;font-size:1.02rem;line-height:1.7;color:#2a2a2a;font-style:italic}
.quote span{font-style:normal;font-weight:600}
.map{border:1px solid var(--border)}
.hours{list-style:none;max-width:26rem} .hours li{display:flex;justify-content:space-between;padding:.4rem 0;border-bottom:1px solid var(--border);font-family:"Libre Franklin",sans-serif;font-size:.95rem}
.btn{display:inline-block;margin-top:1rem;padding:.7rem 1.2rem;background:var(--accent);color:#fff;font-family:var(--font-mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase}
.trusted{display:flex;gap:2rem;align-items:center;flex-wrap:wrap;justify-content:flex-start} .trusted img{max-height:56px;width:auto}
.quote blockquote{font-size: clamp(.95rem, 3.6vw, 1.02rem);}
.trusted{justify-content:center; gap:1.2rem;} .trusted img{max-height:42px} .hide-mobile{} @media(max-width:767px){.hide-mobile{display:none} .hero{width:100%; margin-left:0; left:0} .hero-bg img{object-position:center 40%} }
</style>
