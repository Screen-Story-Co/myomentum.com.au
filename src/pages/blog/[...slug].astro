---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(p => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Date(post.data.date).toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base
  title={`${post.data.title} | Demetris Yiapanis`}
  description={post.data.excerpt}
  ogType="article"
>
  <div class="container">
    <section class="sheet">
      <div class="sheet-rail">
        <span class="rail-label">Journal</span>
      </div>
      <div class="sheet-body">
        <p class="sheet-note">
          {formattedDate} &nbsp;&middot;&nbsp; <a href="/journal" class="link">All entries</a>
        </p>
        <h1 class="entry-title">{post.data.title}</h1>
        <article class="prose"><Content /></article>
        <p class="sheet-outro">
          <a href="/journal" class="link">&larr; Back to Journal</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .entry-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 2rem;
  }
</style>

<style is:global>
  .prose p { margin-bottom: 1.2rem; line-height: 1.8; font-size: 1.05rem; }
  .prose p:first-child { margin-top: 0; }
  .prose em { font-style: italic; color: var(--muted); }
  .prose strong { font-weight: 500; color: var(--fg); }
  .prose blockquote {
    border-left: 2px solid var(--accent);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--muted);
    font-style: italic;
  }
</style>
